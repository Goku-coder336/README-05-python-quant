# Copy to .env.local and fill in. Never commit .env.local.

# Postgres connection string. On Supabase: Project settings > Database > Connection string (URI).
DATABASE_URL=
# Set to true for hosted Postgres (Supabase, Neon) that requires TLS.
DATABASE_SSL=

# Long random string used to sign session cookies. Generate: openssl rand -hex 32
SESSION_SECRET=

# Email for sign-in codes (Resend). Leave empty in development: codes print to the server log.
RESEND_API_KEY=
EMAIL_FROM="Festora <hello@your-domain.com>"

# Public base URL, used in emails.
APP_URL=http://localhost:3000
